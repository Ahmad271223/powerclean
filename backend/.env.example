# Copy this file to `.env` (local dev) or set these as environment variables
# in the Render dashboard (production). `.env` itself is gitignored.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=powerclean

# --- Auth ---
JWT_SECRET=change-me

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Inquiry email notifications ---
# Sent automatically whenever someone submits the /anfrage form.
# Use an app password if your provider requires one (e.g. Gmail).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-smtp-username
# Recipient for new-inquiry notifications (defaults to batutta@msn.com if unset)
INQUIRY_NOTIFY_EMAIL=batutta@msn.com
