# Stundenzettel Pro – Umgebung (Kopie als .env neben docker-compose.yml)

# Pflicht im Betrieb: langer Zufallswert, z. B.  openssl rand -hex 32
JWT_SECRET=bitte-ersetzen
# Betreiber-Schlüssel zum Freischalten von Firmen (POST /api/admin/plan)
ADMIN_TOKEN=bitte-ersetzen

# Öffentliche Adresse (für Einladungslinks), ohne Schrägstrich am Ende
BASE_URL=https://pro.deine-domain.de
# Erlaubte Browser-Herkünfte (Komma-getrennt). Wird das Frontend vom selben Server geliefert, reicht die BASE_URL.
CORS_ORIGINS=https://pro.deine-domain.de

# Datenbank (docker compose setzt MONGO_URL selbst)
DB_MODE=mongo
MONGO_URL=mongodb://mongo:27017
DB_NAME=stundenzettel_pro

# Dateien (Personal-/Projektakte), max. Größe je Datei in MB
DATA_DIR=/daten
MAX_DATEI_MB=15

# Testphase neuer Firmen in Tagen
TEST_TAGE=14
ZEITZONE=Europe/Berlin

# Push-Nachrichten (iPhone über Apple, Android über Google/Firebase) – Schlüssel nur hier, nie in der App
# PUSH_MODUS: leer = zustellen, wenn Zugangsdaten da sind | test = Testersatz (nichts verlässt den Server) | aus
PUSH_MODUS=
# iPhone: developer.apple.com → Keys → „Apple Push Notifications service“ → .p8 herunterladen (gibt es nur einmal)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_SCHLUESSEL_DATEI=/geheim/AuthKey.p8
# auto: erst Produktion (TestFlight/App Store), dann Entwicklung (Xcode-Builds)
APNS_UMGEBUNG=auto
# Android: Firebase-Konsole → Projekteinstellungen → Dienstkonten → „Neuen privaten Schlüssel generieren“ (JSON)
FCM_DIENSTKONTO_DATEI=/geheim/firebase-dienstkonto.json
# 1 = Push-Text ohne Projekt/Straße/Zeit („Neue Einteilung – in der App ansehen“)
PUSH_OHNE_DETAILS=
