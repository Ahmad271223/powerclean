# Stundenzettel Pro – Umgebung (Kopie als .env neben docker-compose.yml)

# Pflicht im Betrieb: langer Zufallswert, z. B.  openssl rand -hex 32
JWT_SECRET=bitte-ersetzen
# Betreiber-Schlüssel zum Freischalten von Firmen (POST /api/admin/plan)
ADMIN_TOKEN=bitte-ersetzen

# Öffentliche Adresse (für Einladungslinks), ohne Schrägstrich am Ende
BASE_URL=https://pro.deine-domain.de
# Erlaubte Browser-Herkünfte (Komma-getrennt). Wird das Frontend vom selben Server geliefert, reicht die BASE_URL.
CORS_ORIGINS=https://pro.deine-domain.de

# Datenbank (docker compose setzt MONGO_URL selbst)
DB_MODE=mongo
MONGO_URL=mongodb://mongo:27017
DB_NAME=stundenzettel_pro

# Dateien (Personal-/Projektakte), max. Größe je Datei in MB
DATA_DIR=/daten
MAX_DATEI_MB=15

# Testphase neuer Firmen in Tagen
TEST_TAGE=14
ZEITZONE=Europe/Berlin
