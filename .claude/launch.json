{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--app-dir",
        "backend",
        "--port",
        "8000",
        "--reload"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "start",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "stundenzettel-app",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "stundenzettel-app",
        "run",
        "preview",
        "--",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "app-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "stundenzettel-app",
        "run",
        "preview",
        "--",
        "--host",
        "0.0.0.0",
        "--port",
        "4175",
        "--strictPort"
      ],
      "port": 4175
    },
    {
      "name": "pro-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "stundenzettel-pro/backend/dev.py"
      ],
      "port": 8010
    },
    {
      "name": "pro-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "stundenzettel-pro/frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
